# TickerWatch Configuration

# Environment
APP_ENV=development
LOG_LEVEL=INFO

# Database Configuration (SQLite file path or URI)
DATABASE_URL=sqlite:///tickerwatch.db

# Ingestion Scheduling Defaults
INGESTION_POLL_INTERVAL_SECONDS=300
HTTP_TIMEOUT_SECONDS=20
MAX_CONNECTOR_CONCURRENCY=2

# Retry and Resilience
MAX_RETRIES=5
BACKOFF_BASE_SECONDS=2.0
BACKOFF_MAX_SECONDS=60.0

# Generic RSS Connector
RSS_ENABLED=true
RSS_FEEDS_CONFIG=config/feeds.yaml
RSS_DEFAULT_POLL_INTERVAL_SECONDS=300

# SEC EDGAR Submissions Connector
SEC_ENABLED=true
# SEC mandates: User-Agent must be in format "Sample Company Name AdminContact@<sample company domain>.com"
SEC_USER_AGENT=TickerWatch/0.1 admin@example.com
# Format: CIK:TICKER pairs comma-separated
SEC_TRACKED_CIKS=0000320193:AAPL,0001018724:AMZN,0000789019:MSFT
SEC_POLL_INTERVAL_SECONDS=600

# Indian Market Feeds (Configurable generic RSS endpoints)
NSE_RSS_ENABLED=false
NSE_POLL_INTERVAL_SECONDS=300

# Article Storage Policy
ARTICLE_RETENTION_DAYS=180
STORE_FULL_CONTENT=false
